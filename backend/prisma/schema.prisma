generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?  @unique
  name      String
  password  String
  avatar    String?
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ads           Ad[]
  favorites     Favorite[]
  platformAuths PlatformAuth[]
}

model Ad {
  id          String   @id @default(cuid())
  title       String
  description String
  price       Int?
  currency    String   @default("RUB")
  category    String
  subcategory String?
  images      String   @default("[]")
  city        String
  address     String?
  status      String   @default("DRAFT")
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author       User                @relation(fields: [authorId], references: [id])
  authorId     String
  favorites    Favorite[]
  publications PlatformPublication[]
}

model Platform {
  id        String   @id @default(cuid())
  name      String   @unique
  url       String
  icon      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  publications PlatformPublication[]
}

model PlatformPublication {
  id           String    @id @default(cuid())
  platformAdId String?
  status       String    @default("PENDING")
  publishedAt  DateTime?
  error        String?
  createdAt    DateTime  @default(now())

  ad         Ad       @relation(fields: [adId], references: [id])
  adId       String
  platform   Platform @relation(fields: [platformId], references: [id])
  platformId String

  @@unique([adId, platformId])
}

model PlatformAuth {
  id           String    @id @default(cuid())
  platform     String
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  user   User @relation(fields: [userId], references: [id])
  userId String

  @@unique([userId, platform])
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  user   User @relation(fields: [userId], references: [id])
  userId String
  ad     Ad   @relation(fields: [adId], references: [id])
  adId   String

  @@unique([userId, adId])
}
